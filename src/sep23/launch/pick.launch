<?xml version="1.0"?>
<!-- Copyright by BeeX [2026] -->
<launch>
    <arg name="sim" default="false" doc="simulated arm instead of the serial port"/>
    <arg name="bag" default="" doc="bag replayed in a loop instead of the live camera, e.g. $(find sep23)/../../data/x.bag"/>
    <arg name="bag_rate" default="1.0" doc="10 suits captures_grasp_poses.bag, recorded a frame every 5 to 10 s"/>
    <arg name="vision" default="false" doc="run axis_grasp and take its grasp poses"/>
    <arg name="foxglove" default="true"/>
    <!-- add-ons, exp/: off unless asked for -->
    <arg name="synthetic" default="false" doc="SYNTHETIC camera instead of the replay: the bag's first frame swaying along a known path"/>
    <arg name="amplitude_m" default="0.02" doc="synthetic sway either side; 0 holds it still"/>
    <arg name="occluded" default="false" doc="paint an obstacle over the camera while the arm moves blind"/>
    <arg name="cover" default="100" doc="the most of the frame the obstacle covers, percent"/>
    <arg name="config" value="$(find sep23)/config"/>

    <arg name="camera_fixed_in_world" value="$(eval synthetic or bag != '')"/>  <!-- a replay saw the scene from one place -->
    <arg name="image" value="$(eval '/synthetic/image' if synthetic else '/image')"/>
    <arg name="cloud" value="$(eval '/synthetic/pointcloud' if synthetic else '/pointcloud')"/>

    <rosparam command="load" ns="robot" file="$(arg config)/robot.yaml"/>
    <param name="robot_description" command="$(find xacro)/xacro $(find sep23)/urdf/robot.urdf.xacro robot_yaml:=$(arg config)/robot.yaml camera_fixed_in_world:=$(arg camera_fixed_in_world)"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

    <node name="driver" pkg="sep23" type="driver" output="screen" required="true">
        <param name="simulated" value="$(arg sim)"/>
    </node>

    <node name="pick" pkg="sep23" type="pick" output="screen">
        <rosparam command="load" file="$(arg config)/pick.yaml"/>
        <param name="camera_fixed_in_world" value="$(arg camera_fixed_in_world)"/>
        <remap from="cloud" to="$(eval '/non_occluded/pointcloud' if occluded else cloud)"/>
        <remap from="image" to="$(eval '/occluder/image' if occluded else image)"/>
        <remap from="grasp_poses" to="$(eval '/synthetic/grasp_poses' if synthetic else '/grasp_poses_by_pipeline' if vision else '/grasp_poses')"/>
    </node>

    <include if="$(eval vision and not synthetic)" file="$(find axis_grasp)/launch/axis_grasp.launch"/>

    <arg name="bag_topics" value="$(eval '--topics /disparity /image /pointcloud' if vision else '')"/>
    <node if="$(eval bag != '' and not synthetic)" name="bag" pkg="rosbag" type="play" args="--loop --quiet --rate=$(arg bag_rate) $(arg bag) $(arg bag_topics)"/>

    <node if="$(arg synthetic)" name="synthetic_drift" pkg="sep23" type="synthetic_drift.py" output="screen" required="true">
        <param name="bag" value="$(arg bag)"/>
        <param name="amplitude_m" value="$(arg amplitude_m)"/>
    </node>

    <node if="$(arg occluded)" name="occluder" pkg="sep23" type="occluder.py" output="screen" required="true">
        <param name="cover" value="$(arg cover)"/>
        <remap from="image" to="$(arg image)"/>
        <remap from="cloud" to="$(arg cloud)"/>
    </node>

    <node if="$(arg foxglove)" name="foxglove" pkg="foxglove_bridge" type="foxglove_bridge">
        <param name="port" value="8765"/>
        <param name="send_buffer_limit" value="100000000"/>
    </node>
</launch>
